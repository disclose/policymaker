{
  "name": "policymaker",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.6",
  "engines": {
    "bun": ">=1.3.6 <2"
  },
  "scripts": {
    "dev": "bun run policies:generate && vite",
    "build": "bun run policies:generate && vue-tsc --noEmit && vite build && bun scripts/generate-static-routes.ts",
    "preview": "vite preview",
    "test": "bun run policies:generate && vitest run",
    "test:watch": "bun run policies:generate && vitest",
    "verify": "bun run test && bun run build && bun run verify:dist && bun run lint:legacy && bun run lint:architecture && bun run policies:check",
    "verify:dist": "bun scripts/verify-dist.ts",
    "policies:generate": "bun scripts/generate-policy-source.ts",
    "policies:check": "bun scripts/generate-policy-source.ts --check",
    "policies:update": "bun scripts/update-dioterms.ts",
    "lint:legacy": "bun scripts/check-legacy.ts",
    "lint:architecture": "bun scripts/check-architecture.ts"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "markdown-it": "^15.0.0",
    "vue": "^3.5.41",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.4.11",
    "bun-types": "^1.3.14",
    "fast-check": "^4.9.0",
    "happy-dom": "^20.11.2",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.9"
  }
}
